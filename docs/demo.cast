[19.036651, "o", "\r\nOpenTofu used the selected providers to generate the following execution plan. Resource actions are\r\nindicated with the following symbols:\r\n"]
[19.037018, "o", "  \u001b[33m~\u001b[0m update in-place (current -> planned)\u001b[0m\r\n\r\nOpenTofu will perform the following actions:\r\n"]
[19.037089, "o", "\r\n\u001b[1m  # homeassistant_automation.yaml[\"sunset_lights\"]\u001b[0m will be updated in-place\r\n\u001b[0m  \u001b[33m~\u001b[0m\u001b[0m resource \"homeassistant_automation\" \"yaml\" {\r\n      \u001b[33m~\u001b[0m\u001b[0m config    = {\r\n          \u001b[33m~\u001b[0m\u001b[0m actions     = [\r\n              \u001b[33m~\u001b[0m\u001b[0m {\r\n                  \u001b[33m~\u001b[0m\u001b[0m data   = {\r\n                      \u001b[33m~\u001b[0m\u001b[0m brightness_pct = 100 \u001b[33m->\u001b[0m\u001b[0m 70\r\n                    }\r\n                    \u001b[90m# (2 unchanged attributes hidden)\u001b[0m\u001b[0m\r\n                },\r\n            ]\r\n            \u001b[90m# (4 unchanged attributes hidden)\u001b[0m\u001b[0m\r\n        }\r\n        id        = \"sunset_lights\"\r\n        \u001b[90m# (1 unchanged attribute hidden)\u001b[0m\u001b[0m\r\n    }\r\n"]
[19.037308, "o", "\r\n\u001b[1mPlan:\u001b[0m 0 to add, 1 to change, 0 to destroy.\r\n\u001b[0m\u001b[90m\r\n───────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\r\nNote: You didn't use the -out option to save this plan, so OpenTofu can't guarantee to take exactly\r\nthese actions if you run \"tofu apply\" now.\r\n"]
