[10.379968, "o", "\r\n"]
[10.383489, "o", "alias: Living room lights at sunset\r\ndescription: Turns on the living room lights when the sun sets.\r\ntriggers:\r\n  - trigger: sun\r\n    event: sunset\r\n    offset: \"-00:15:00\"\r\nactions:\r\n  - action: light.turn_on\r\n    target:\r\n      area_id: living_room\r\n    data:\r\n      brightness_pct: 70\r\nmode: single\r\n"]
