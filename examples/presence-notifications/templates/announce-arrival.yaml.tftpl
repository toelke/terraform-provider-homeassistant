---
alias: Announce ${arriving.name} home
description: ''
triggers:
- trigger: state
  entity_id: ${arriving.person}
  from: not_home
  to: home
conditions: []
actions:
- choose:
  # the listener is home with something playing on the phone: pause it and speak
  - conditions:
    - condition: state
      entity_id: ${listener.media}
      state: Playing
    - condition: zone
      entity_id: ${listener.tracker}
      zone: zone.home
    sequence:
    - action: ${listener.phone}
      data:
        message: command_media
        data:
          media_command: pause
          media_package_name: com.example.podcastplayer
    - action: ${listener.phone}
      data:
        message: TTS
        data:
          ttl: 0
          priority: high
          media_stream: alarm_stream_max
          tts_text: ${arriving.name} is home
  # otherwise, if anyone is home, show it on the hallway tablet
  - conditions:
    - condition: or
      conditions:
%{ for p in people ~}
      - condition: zone
        entity_id: ${p}
        zone: zone.home
%{ endfor ~}
    sequence:
    - action: notify.send_message
      data:
        message: ${arriving.name} is home
      target:
        device_id: ${tablet_id}
mode: single
